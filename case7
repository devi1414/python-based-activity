candidates = []
quota = int(input("Enter scholarship quota: "))
n = int(input("Enter number of candidates: "))

if quota < 0 or n <= 0:
    print("Invalid input")
else:
    for i in range(n):
        print("\nCandidate", i + 1)
        name = input("Enter name: ")
        marks = float(input("Enter academic marks (%): "))
        attendance = float(input("Enter attendance (%): "))
        income = float(input("Enter annual family income: "))

        if (marks < 0 or marks > 100
                or attendance < 0 or attendance > 100
                or income < 0):
            print("Invalid candidate details")
        elif (marks >= 75 and attendance >= 80
              and income <= 200000):
            candidates.append((name, marks, attendance, income))

    # Sort by marks, then attendance
    for i in range(len(candidates)):
        for j in range(i + 1, len(candidates)):
            if (candidates[j][1] > candidates[i][1]
                or (candidates[j][1] == candidates[i][1]
                    and candidates[j][2] > candidates[i][2])):
                candidates[i], candidates[j] = candidates[j], candidates[i]

    print("\n--- SCHOLARSHIP SELECTION ---")

    selected = min(quota, len(candidates))

    if selected == 0:
        print("No candidates selected")
    else:
        for i in range(selected):
            print("Rank:", i + 1)
            print("Name:", candidates[i][0])
            print("Marks:", candidates[i][1])
            print("Attendance:", candidates[i][2])
            print()
