ids = []
amounts = []

n = int(input("Enter number of transactions: "))
threshold = float(input("Enter suspicious amount threshold: "))

if n <= 0 or threshold < 0:
    print("Invalid input")
else:
    for i in range(n):
        print("\nTransaction", i + 1)
        tid = input("Enter transaction ID: ")
        amount = float(input("Enter transaction amount: "))

        ids.append(tid)
        amounts.append(amount)

    suspicious = []

    for i in range(n):
        duplicate = False

        for j in range(n):
            if i != j and ids[i] == ids[j]:
                duplicate = True

        reasons = []

        if duplicate:
            reasons.append("Duplicate ID")

        if amounts[i] > threshold:
            reasons.append("High amount")

        if len(reasons) > 0:
            suspicious.append((ids[i], amounts[i], reasons))

    print("\n--- TRANSACTION SUMMARY ---")
    print("Total Transactions:", n)
    print("Suspicious Transactions:")

    if len(suspicious) == 0:
        print("No suspicious transactions found")
    else:
        for item in suspicious:
            print("ID:", item[0])
            print("Amount: Rs.", item[1])
            print("Reason:", ", ".join(item[2]))
            print()
