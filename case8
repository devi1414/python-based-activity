names = []
original = []
moderated = []

n = int(input("Enter number of students: "))
subjects = int(input("Enter number of subjects: "))
bonus = float(input("Enter moderation bonus marks: "))

if n <= 0 or subjects <= 0 or bonus < 0:
    print("Invalid input")

else:
    valid = True

    for i in range(n):
        name = input("\nEnter student name: ")
        names.append(name)

        row = []

        for j in range(subjects):
            mark = float(input("Enter original marks: "))

            if mark < 0 or mark > 100:
                valid = False
                break

            row.append(mark)

        if len(row) != subjects:
            valid = False
            break

        original.append(row)

    if not valid:
        print("Invalid marks. Run the program again.")

    else:
        for i in range(n):
            row = []

            for j in range(subjects):
                new_mark = original[i][j] + bonus

                if new_mark > 100:
                    new_mark = 100

                row.append(new_mark)

            moderated.append(row)

        print("\n--- EXAMINATION RESULTS ---")

        for i in range(n):
            old_total = sum(original[i])
            new_total = sum(moderated[i])

            old_pass = True
            new_pass = True

            for j in range(subjects):
                if original[i][j] < 40:
                    old_pass = False

                if moderated[i][j] < 40:
                    new_pass = False

            print("\nStudent:", names[i])
            print("Original Marks:", original[i])
            print("Moderated Marks:", moderated[i])
            print("Original Total:", old_total)
            print("Moderated Total:", new_total)

            if old_pass:
                print("Original Result: PASS")
            else:
                print("Original Result: FAIL")

            if new_pass:
                print("Moderated Result: PASS")
            else:
                print("Moderated Result: FAIL")
