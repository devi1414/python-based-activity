n = int(input("Enter diamond size: "))

if n <= 0:
    print("Invalid size. Enter a positive number.")
else:
    # Upper half
    for i in range(1, n + 1):
        print(" " * (n - i), end="")

        for j in range(1, i + 1):
            print(j, end="")

        for j in range(i - 1, 0, -1):
            print(j, end="")

        print()

    # Lower half
    for i in range(n - 1, 0, -1):
        print(" " * (n - i), end="")

        for j in range(1, i + 1):
            print(j, end="")

        for j in range(i - 1, 0, -1):
            print(j, end="")

        print()
