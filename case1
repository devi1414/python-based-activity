# University Scholarship Allocation

applicants = [
    {
        "name": "Ravi",
        "aggregate": 88,
        "subjects": [85, 90, 88],
        "attendance": 92,
        "income": 180000
    },
    {
        "name": "Sita",
        "aggregate": 88,
        "subjects": [80, 85, 90],
        "attendance": 95,
        "income": 150000
    },
    {
        "name": "Arun",
        "aggregate": 70,
        "subjects": [65, 72, 68],
        "attendance": 80,
        "income": 200000
    }
]

eligible = []

for student in applicants:
    if (student["aggregate"] >= 75
            and min(student["subjects"]) >= 60
            and student["attendance"] >= 75
            and student["income"] <= 250000):

        eligible.append(student)
        print(student["name"], "- Eligible")
    else:
        print(student["name"], "- Not Eligible")

# Ranking: aggregate marks, attendance,
# then lower family income
eligible.sort(
    key=lambda s: (
        -s["aggregate"],
        -s["attendance"],
        s["income"]
    )
)

print("\nScholarship Ranking")

for rank, student in enumerate(eligible, start=1):
    print(
        rank, student["name"],
        "Marks:", student["aggregate"],
        "Attendance:", student["attendance"]
    )

