records = []
seen_ids = []

n = int(input("Enter number of records: "))

if n <= 0:
    print("Invalid number of records")

else:
    for i in range(n):
        record = input("Enter ID|NAME|BRANCH: ")
        fields = record.split("|")
        errors = []

        if len(fields) != 3:
            errors.append("Incorrect number of fields")

        else:
            sid = fields[0].strip()
            name = fields[1].strip()
            branch = fields[2].strip()

            if len(sid) != 6 or not sid.isdigit():
                errors.append("Invalid ID")

            if (name == "" or
                not all(ch.isalpha() or ch == " "
                        for ch in name)):
                errors.append("Invalid name")

            if (len(branch) != 3 or
                not branch.isalpha() or
                branch != branch.upper()):
                errors.append("Invalid branch")

            if sid in seen_ids:
                errors.append("Duplicate ID")

            seen_ids.append(sid)

        records.append((record, errors))

    print("\n--- REGISTRATION REPORT ---")

    for record, errors in records:
        print("\nRecord:", record)

        if len(errors) == 0:
            print("Status: Valid")
        else:
            print("Status: Invalid")
            for error in errors:
                print("-", error)
