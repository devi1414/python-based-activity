venue = float(input("Enter venue cost: "))
equipment = float(input("Enter equipment cost: "))
transport = float(input("Enter transport cost: "))
catering = float(input("Enter catering cost per participant: "))
certificate = float(input("Enter certificate cost per participant: "))
participants = int(input("Enter number of participants: "))
sponsorship = float(input("Enter sponsorship amount: "))
fee = float(input("Enter registration fee per participant: "))

if (venue < 0 or equipment < 0 or transport < 0
        or catering < 0 or certificate < 0
        or participants < 0 or sponsorship < 0 or fee < 0):
    print("Invalid input")
else:
    fixed_cost = venue + equipment + transport
    variable_cost = catering + certificate

    total_cost = fixed_cost + participants * variable_cost
    registration_income = participants * fee
    available_funds = registration_income + sponsorship
    balance = available_funds - total_cost

    print("\n--- CAMPUS EVENT REPORT ---")
    print("Fixed Cost: Rs.", fixed_cost)
    print("Total Event Cost: Rs.", total_cost)
    print("Registration Income: Rs.", registration_income)
    print("Sponsorship: Rs.", sponsorship)
    print("Total Available Funds: Rs.", available_funds)

    if balance >= 0:
        print("Surplus: Rs.", round(balance, 2))
    else:
        print("Sponsorship Shortfall: Rs.", round(-balance, 2))

    if fee <= variable_cost:
        print("Break-even is not possible with this registration fee.")
    else:
        registrations = 0

        while (sponsorship + registrations * fee
               < fixed_cost + registrations * variable_cost):
            registrations = registrations + 1

        print("Minimum Registrations Needed:", registrations)
