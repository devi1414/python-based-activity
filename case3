total = int(input("Enter total classes conducted: "))
attended = int(input("Enter classes attended: "))
threshold = float(input("Enter required attendance percentage: "))

if (total <= 0 or attended < 0 or attended > total
        or threshold <= 0 or threshold >= 100):
    print("Invalid input")
else:
    percentage = attended / total * 100

    print("Current Attendance:", round(percentage, 2), "%")

    if percentage >= threshold:
        print("Status: Eligible")
        print("Additional classes required: 0")
    else:
        required = 0

        while ((attended + required) / (total + required) * 100
               < threshold):
            required = required + 1

        print("Status: Not Eligible")
        print("Minimum consecutive classes to attend:", required)
